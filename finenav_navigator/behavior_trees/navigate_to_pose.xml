<!--
  Navigate to pose with goal-reached detection.
  Uses ReactiveFallback: if IsGoalReached succeeds → tree succeeds and the tracking
  layer is halted.

  PublishNavigationGoal: 注入 goal_poses[]（开始导航）。
  StartControlLayer:     手动启动单个 control layer 并持续跟踪。
  -->
<root BTCPP_format="4">

    <!-- 基础导航：持续追踪，到达目标后发布零速并成功退出 -->
    <BehaviorTree ID="NavigateToPose">
        <Sequence>
            <PublishNavigationGoal/>
            <RetryUntilSuccessful num_attempts="-1">
                <Sequence name="TrackThenStop">
                    <ReactiveFallback name="NavigateOrSucceed">
                        <IsGoalReached  robot_pose="{robot_pose}"
                                        robot_twist="{robot_twist}"
                                        goal="{goal}"
                                        xy_tolerance="0.25"
                                        yaw_tolerance="1.57"
                                        speed_tolerance="0.1"/>
                        <StartControlLayer layer="mppi_layer"/>
                    </ReactiveFallback>
                    <!-- ReactiveFallback 返回 SUCCESS（IsGoalReached触发）后，发布零速 -->
                    <StopChassisMotion/>
                </Sequence>
            </RetryUntilSuccessful>
        </Sequence>
    </BehaviorTree>

    <!-- 带卡死检测的导航：卡死时发布零速后整棵树 FAILURE -->
    <BehaviorTree ID="NavigateWithStuckDetection">
        <Sequence>
            <PublishNavigationGoal/>
            <RetryUntilSuccessful num_attempts="-1">
                <Sequence name="TrackThenStop">
                    <ReactiveFallback name="NavigateOrSucceed">
                        <IsGoalReached  robot_pose="{robot_pose}"
                                        robot_twist="{robot_twist}"
                                        goal="{goal}"
                                        xy_tolerance="0.25"
                                        yaw_tolerance="1.57"
                                        speed_tolerance="0.1"/>
                        <ReactiveSequence name="TrackUnlessStuck">
                            <Inverter>
                                <IsStuck robot_pose="{robot_pose}"
                                         dist_threshold="0.05"
                                         timeout_s="5.0"/>
                            </Inverter>
                            <StartControlLayer layer="mppi_layer"/>
                        </ReactiveSequence>
                    </ReactiveFallback>
                    <!-- ReactiveFallback 返回 SUCCESS（IsGoalReached触发）后，发布零速 -->
                    <StopChassisMotion/>
                </Sequence>
            </RetryUntilSuccessful>
        </Sequence>
    </BehaviorTree>

    <!-- 动态目标跟随：通过话题订阅持续更新目标点，在目标后方 follow_distance 处跟随 -->
    <BehaviorTree ID="DynamicFollowPose">
        <Sequence>
            <PublishNavigationGoal/>
            <RetryUntilSuccessful num_attempts="-1">
                <ReactiveFallback name="NavigateOrSucceed">
                    <DynamicGoalFollower topic_name="/target_pose"
                                         robot_pose="{robot_pose}"
                                         goal="{goal}"
                                         follow_distance="0.5"
                                         update_distance="0.1">
                        <StartControlLayer layer="mppi_layer"/>
                    </DynamicGoalFollower>
                </ReactiveFallback>
            </RetryUntilSuccessful>
        </Sequence>
    </BehaviorTree>

</root>
