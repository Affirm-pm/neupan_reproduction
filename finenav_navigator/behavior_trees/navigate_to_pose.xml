<!--
  Navigate to pose with goal-reached detection.
  Uses ReactiveFallback: if IsGoalReached succeeds → tree succeeds and ComputePlan is halted.

  layer:       ControlLayer name registered via createLayer(...).
  planner_id:  must match AlgoConfigurator<T>::name of the planner loaded in the ControlLayer.
  -->
<root BTCPP_format="4">

    <!-- 基础导航：持续追踪，到达目标后发布零速并成功退出 -->
    <BehaviorTree ID="NavigateToPose">
        <RetryUntilSuccessful num_attempts="-1">
            <Sequence name="TrackThenStop">
                <ReactiveFallback name="NavigateOrSucceed">
                    <IsGoalReached  robot_pose="{robot_pose}"
                                    robot_twist="{robot_twist}"
                                    goal="{goal}"
                                    xy_tolerance="0.25"
                                    yaw_tolerance="1.57"
                                    speed_tolerance="0.1"/>
                    <ComputePlan    layer="mppi_layer"
                                    goal="{goal}"
                                    planner_id="finenav_mppi_controller"/>
                </ReactiveFallback>
                <!-- ReactiveFallback 返回 SUCCESS（IsGoalReached触发）后，发布零速 -->
                <StopChassisMotion/>
            </Sequence>
        </RetryUntilSuccessful>
    </BehaviorTree>

    <!-- 带卡死检测的导航：卡死时发布零速后整棵树 FAILURE -->
    <BehaviorTree ID="NavigateWithStuckDetection">
        <RetryUntilSuccessful num_attempts="-1">
            <Sequence name="TrackThenStop">
                <ReactiveFallback name="NavigateOrSucceed">
                    <IsGoalReached  robot_pose="{robot_pose}"
                                    robot_twist="{robot_twist}"
                                    goal="{goal}"
                                    xy_tolerance="0.25"
                                    yaw_tolerance="1.57"
                                    speed_tolerance="0.1"/>
                    <ReactiveSequence name="TrackUnlessStuck">
                        <Inverter>
                            <IsStuck robot_pose="{robot_pose}"
                                     dist_threshold="0.05"
                                     timeout_s="5.0"/>
                        </Inverter>
                        <ComputePlan layer="mppi_layer"
                                     goal="{goal}"
                                     planner_id="finenav_mppi_controller"/>
                    </ReactiveSequence>
                </ReactiveFallback>
                <!-- ReactiveFallback 返回 SUCCESS（IsGoalReached触发）后，发布零速 -->
                <StopChassisMotion/>
            </Sequence>
        </RetryUntilSuccessful>
    </BehaviorTree>

    <!-- 动态目标跟随：通过话题订阅持续更新目标点，在目标后方 follow_distance 处跟随 -->
    <BehaviorTree ID="DynamicFollowPose">
        <RetryUntilSuccessful num_attempts="-1">
            <ReactiveFallback name="NavigateOrSucceed">
                <DynamicGoalFollower topic_name="/target_pose"
                                     robot_pose="{robot_pose}"
                                     goal="{goal}"
                                     follow_distance="0.5"
                                     update_distance="0.1">
                    <ComputePlan   layer="mppi_layer"
                                   goal="{goal}"
                                   planner_id="finenav_mppi_controller"/>
                </DynamicGoalFollower>
            </ReactiveFallback>
        </RetryUntilSuccessful>
    </BehaviorTree>

</root>

