<?xml version="1.0"?>
<package format="3">
    <name>finenav_simulator</name>
    <version>0.5.1</version>
    <description>Gazebo Sim resources, ROS bridges, and helper nodes for FineNav-Engine simulation, including robot spawning, point-cloud conversion, teleoperation, and odometry.</description>
    <maintainer email="021424216@sues.edu.cn">Chenghao Wang</maintainer>
    <license>MPL-2.0</license>
    <buildtool_depend>ament_cmake</buildtool_depend>
    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <depend>ros_gz_sim</depend>
    <depend>ros_gz_bridge</depend>
    <depend>pcl_conversions</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>tf2_ros</depend>
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
