<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>finenav_rotate_shim</name>
  <version>0.1.0</version>
  <description>RotateShim planner for FineNav — rotates robot to face path heading before tracking</description>
  <maintainer email="wangjinghui@sjtu.edu.cn">Jinghui Wang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>finenav_core</depend>
  <depend>generate_parameter_library</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
